<%- include('partials/header') %>

<div class="container py-4">
  <div class="card border mb-4">
    <div class="card-body">
      <div class="d-flex align-items-start gap-4 flex-wrap">
        <% if (profile.avatar) { %>
          <img src="<%= profile.avatar %>" class="rounded-circle flex-shrink-0" width="80" height="80" style="object-fit:cover">
        <% } else { %>
          <div class="avatar-xl flex-shrink-0"><%= profile.username[0].toUpperCase() %></div>
        <% } %>
        <div class="flex-grow-1">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
            <h4 class="fw-bold mb-0">@<%= profile.username %></h4>
            <div class="d-flex gap-2">
              <% if (!isOwn) { %>
                <form action="/follow/<%= profile._id %>" method="POST">
                  <button type="submit" class="btn btn-sm <%= isFollowing ? 'btn-outline-secondary' : 'btn-primary' %>">
                    <%= isFollowing ? 'Unfollow' : 'Follow' %>
                  </button>
                </form>
                <a href="/dm/<%= profile.username %>" class="btn btn-outline-secondary btn-sm">Message</a>
                <a href="/video/call/<%= profile.username %>" class="btn btn-outline-success btn-sm">Video Call</a>
              <% } else { %>
                <a href="/users/<%= profile.username %>/settings" class="btn btn-outline-secondary btn-sm">Edit Profile</a>
              <% } %>
            </div>
          </div>
          <% if (profile.bio) { %><p class="text-muted mb-2"><%= profile.bio %></p><% } %>
          <div class="d-flex gap-4 mt-2">
            <div class="text-center"><div class="fw-bold"><%= posts.length %></div><div class="text-muted small">Posts</div></div>
            <div class="text-center"><div class="fw-bold"><%= profile.followers ? profile.followers.length : 0 %></div><div class="text-muted small">Followers</div></div>
            <div class="text-center"><div class="fw-bold"><%= profile.following ? profile.following.length : 0 %></div><div class="text-muted small">Following</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h6 class="fw-semibold mb-3">Posts by @<%= profile.username %></h6>

  <% if (posts.length === 0) { %>
    <div class="card border text-center py-4"><p class="text-muted mb-0">No posts yet.</p></div>
  <% } %>

  <% posts.forEach(post => { %>
    <div class="card border mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-1">
          <a href="/posts/<%= post._id %>" class="text-decoration-none text-dark">
            <h6 class="fw-semibold mb-1"><%= post.title %></h6>
          </a>
          <small class="text-muted ms-2 text-nowrap">
            <%= new Date(post.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>
          </small>
        </div>
        <% if (post.body) { %>
          <p class="text-muted small mb-2"><%= post.body.substring(0, 100) %><%= post.body.length > 100 ? '...' : '' %></p>
        <% } %>
        <% if (post.media && post.media.length > 0) { %>
          <div class="d-flex gap-1 mb-2 flex-wrap">
            <% post.media.slice(0,3).forEach(m => { %>
              <% if (m.type === 'image') { %>
                <img src="<%= m.url %>" class="rounded" style="width:60px;height:60px;object-fit:cover;" alt="">
              <% } else { %>
                <div class="rounded bg-dark text-white d-flex align-items-center justify-content-center" style="width:60px;height:60px;font-size:11px;">Video</div>
              <% } %>
            <% }) %>
          </div>
        <% } %>
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <% if (post.tags && post.tags.length > 0) { %>
              <% post.tags.slice(0,3).forEach(tag => { %><span class="badge bg-light text-secondary border me-1" style="font-size:11px">#<%= tag %></span><% }) %>
            <% } %>
          </div>
          <small class="text-muted">&#10084; <%= post.likes.length %></small>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
