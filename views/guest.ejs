<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SocialSphere</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
<nav class="navbar navbar-light bg-white border-bottom">
  <div class="container">
    <a class="navbar-brand fw-bold" style="color:#0d6efd;">SocialSphere</a>
    <div class="d-flex gap-2">
      <a href="/auth/login" class="btn btn-outline-primary btn-sm">Login</a>
      <a href="/auth/register" class="btn btn-primary btn-sm">Register</a>
    </div>
  </div>
</nav>
<div class="container py-5">
  <div class="row align-items-center">
    <div class="col-md-6">
      <h1 class="display-5 fw-bold mb-3">Welcome to SocialSphere</h1>
      <p class="lead text-muted mb-4">Share posts with photos and videos, follow friends, chat privately, and use AI to write better.</p>
      <div class="d-flex gap-3">
        <a href="/auth/register" class="btn btn-primary btn-lg px-4">Get Started</a>
        <a href="/auth/login" class="btn btn-outline-secondary btn-lg px-4">Login</a>
      </div>
    </div>
    <div class="col-md-6 mt-4 mt-md-0">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-3">What you can do:</h5>
          <ul class="list-group list-group-flush">
            <li class="list-group-item">Write posts with photos and videos</li>
            <li class="list-group-item">Follow other users</li>
            <li class="list-group-item">Like and comment on posts</li>
            <li class="list-group-item">Live group chat</li>
            <li class="list-group-item">Private messaging</li>
            <li class="list-group-item">AI writing assistant</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
