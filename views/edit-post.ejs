<%- include('partials/header') %>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Edit Post</h5>
        <a href="/posts/<%= post._id %>" class="text-decoration-none text-muted small">Cancel</a>
      </div>
      <div class="card border">
        <div class="card-body p-4">
          <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger">
              <ul class="mb-0 ps-3"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
            </div>
          <% } %>
          <form action="/posts/<%= post._id %>/edit" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold">Title *</label>
              <input type="text" name="title" class="form-control" value="<%= post.title %>" maxlength="100" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Content</label>
              <textarea name="body" class="form-control" rows="10" maxlength="5000"><%= post.body %></textarea>
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold">Tags (optional)</label>
              <input type="text" name="tags" class="form-control" value="<%= post.tags ? post.tags.join(', ') : '' %>" placeholder="javascript, tips, webdev">
            </div>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Save Changes</button>
              <a href="/posts/<%= post._id %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
