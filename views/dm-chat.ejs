<%- include('partials/header') %>

<div class="container py-3">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/dm" class="text-decoration-none text-muted small">&larr; Messages</a>
        <span class="text-muted">|</span>
        <% if (other.avatar) { %>
          <img src="<%= other.avatar %>" class="rounded-circle" width="28" height="28" style="object-fit:cover">
        <% } else { %>
          <div class="avatar-xs"><%= other.username[0].toUpperCase() %></div>
        <% } %>
        <a href="/users/<%= other.username %>" class="fw-semibold text-decoration-none text-dark small">@<%= other.username %></a>

        <!-- Video call button -->
        <a href="/video/call/<%= other.username %>" class="btn btn-outline-success btn-sm ms-auto"
          title="Start video call with @<%= other.username %>">
          Video Call
        </a>
      </div>

      <div class="card border d-flex flex-column" style="height:calc(100vh - 200px)">
        <!-- Messages -->
        <div class="card-body overflow-auto flex-grow-1 p-3" id="messagesDiv">
          <% if (messages.length === 0) { %>
            <div class="text-center text-muted py-4 small">No messages yet. Say hello!</div>
          <% } %>
          <% messages.forEach(msg => { %>
            <% const fromMe = String(msg.from) === String(me._id); %>
            <div class="d-flex mb-3 <%= fromMe ? 'justify-content-end' : '' %>">
              <% if (!fromMe) { %>
                <% if (other.avatar) { %>
                  <img src="<%= other.avatar %>" class="rounded-circle me-2 flex-shrink-0" width="28" height="28" style="object-fit:cover">
                <% } else { %>
                  <div class="avatar-xs me-2 flex-shrink-0"><%= other.username[0].toUpperCase() %></div>
                <% } %>
              <% } %>
              <div>
                <div class="chat-bubble <%= fromMe ? 'chat-bubble-own' : '' %>"><%= msg.body %></div>
                <div class="chat-meta <%= fromMe ? 'text-end' : '' %>">
                  <%= new Date(msg.createdAt).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Typing indicator -->
        <div class="px-3 py-1" style="min-height:20px;font-size:12px;color:#888;" id="typingIndicator"></div>

        <!-- Input -->
        <div class="card-footer bg-white p-2">
          <div class="input-group">
            <input type="text" id="dmInput" class="form-control form-control-sm"
              placeholder="Type a message..." maxlength="2000" autocomplete="off">
            <button class="btn btn-primary btn-sm" id="dmSendBtn">Send</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const CURRENT_USER = { _id: "<%= me._id %>", username: "<%= me.username %>", avatar: "<%= me.avatar || '' %>" };
  const OTHER_USER   = { _id: "<%= other._id %>", username: "<%= other.username %>", avatar: "<%= other.avatar || '' %>" };
</script>
<script src="/js/dm.js"></script>
<%- include('partials/footer') %>
