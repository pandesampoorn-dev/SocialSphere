<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - SocialSphere</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<% if (user) { %>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/" style="color:#0d6efd;">SocialSphere</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <form class="d-flex mx-auto" action="/users/search/results" method="GET">
        <input class="form-control me-2" type="search" name="q" placeholder="Search users..." style="width:220px">
        <button class="btn btn-outline-primary btn-sm" type="submit">Search</button>
      </form>
      <ul class="navbar-nav ms-auto align-items-center gap-1">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/chat">Chat</a></li>
        <li class="nav-item"><a class="nav-link" href="/dm">Messages</a></li>
        <li class="nav-item"><a class="btn btn-primary btn-sm px-3" href="/posts/create">+ New Post</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" class="rounded-circle" width="28" height="28" style="object-fit:cover">
            <% } else { %>
              <div class="avatar-sm"><%= user.username[0].toUpperCase() %></div>
            <% } %>
            <%= user.username %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/users/<%= user.username %>">My Profile</a></li>
            <li><a class="dropdown-item" href="/users/<%= user.username %>/settings">Settings</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="/auth/logout">Logout</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>

<div class="container mt-3">
  <% if (success_msg && success_msg.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= success_msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= error_msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
</div>

<!-- Global incoming call notification (shown on any page) -->
<% if (user) { %>
<div id="globalCallToast" class="position-fixed bg-dark text-white rounded shadow p-3"
  style="bottom:24px; right:24px; z-index:9999; min-width:260px; display:none;">
  <div class="d-flex align-items-center gap-3 mb-2">
    <div class="avatar-sm" id="toastCallerInitial">?</div>
    <div>
      <div class="fw-semibold small" id="toastCallerName">Someone</div>
      <div class="text-white-50" style="font-size:12px;">is calling you...</div>
    </div>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-success btn-sm flex-fill" id="toastAcceptBtn">Answer</button>
    <button class="btn btn-danger btn-sm flex-fill"  id="toastRejectBtn">Decline</button>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
  // Only register on non-video-call pages (video-call page handles its own signalling)
  if (window.location.pathname.startsWith('/video/call/')) return;

  const ME_ID       = "<%= user._id %>";
  const ME_USERNAME = "<%= user.username %>";

  const toast         = document.getElementById('globalCallToast');
  const callerName    = document.getElementById('toastCallerName');
  const callerInitial = document.getElementById('toastCallerInitial');
  const acceptBtn     = document.getElementById('toastAcceptBtn');
  const rejectBtn     = document.getElementById('toastRejectBtn');

  let pendingCallId   = null;
  let pendingCallerId = null;
  let pendingCallerUsername = null;

  const socket = io('/video');
  socket.on('connect', () => {
    socket.emit('register', { userId: ME_ID, username: ME_USERNAME });
  });

  socket.on('incomingCall', ({ callId, fromUserId, fromUsername }) => {
    pendingCallId          = callId;
    pendingCallerId        = fromUserId;
    pendingCallerUsername  = fromUsername;

    callerName.textContent    = '@' + fromUsername;
    callerInitial.textContent = fromUsername[0].toUpperCase();
    toast.style.display       = 'block';
  });

  socket.on('callEnded', () => {
    toast.style.display = 'none';
    pendingCallId = pendingCallerId = pendingCallerUsername = null;
  });

  acceptBtn.addEventListener('click', () => {
    if (!pendingCallerUsername) return;
    toast.style.display = 'none';
    window.location.href = '/video/call/' + pendingCallerUsername;
  });

  rejectBtn.addEventListener('click', () => {
    if (!pendingCallId || !pendingCallerId) return;
    socket.emit('rejectCall', { callId: pendingCallId, toUserId: pendingCallerId });
    toast.style.display = 'none';
    pendingCallId = pendingCallerId = pendingCallerUsername = null;
  });
})();
</script>
<% } %>
