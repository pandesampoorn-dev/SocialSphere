<%- include('partials/header') %>
<div class="container py-3">
  <div class="row g-3" style="height:calc(100vh - 140px);">
    <div class="col-md-3">
      <div class="card border h-100">
        <div class="card-header bg-white">
          <h6 class="mb-0 fw-semibold">Live Chat</h6>
          <small class="text-muted" id="onlineCount">0 online</small>
        </div>
        <div class="card-body p-0 overflow-auto">
          <div id="onlineList" class="p-2"></div>
        </div>
      </div>
    </div>
    <div class="col-md-9 d-flex flex-column">
      <div class="card border flex-grow-1 d-flex flex-column">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-semibold">Group Chat</h6>
          <span class="badge bg-success" id="statusBadge">Connected</span>
        </div>
        <div class="card-body overflow-auto flex-grow-1" id="messages" style="max-height:450px;">
          <div class="text-center text-muted py-4 small" id="chatWelcome">Say hello to everyone!</div>
        </div>
        <div class="px-3 py-1" style="min-height:24px;font-size:12px;color:#888;" id="typingIndicator"></div>
        <div class="card-footer bg-white">
          <div class="input-group">
            <input type="text" id="msgInput" class="form-control" placeholder="Type a message..." maxlength="500" autocomplete="off">
            <button class="btn btn-primary" id="sendBtn">Send</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script>
  const CURRENT_USER = { username: "<%= user.username %>", avatar: "<%= user.avatar || '' %>" };
</script>
<script src="/js/chat.js"></script>
<%- include('partials/footer') %>
