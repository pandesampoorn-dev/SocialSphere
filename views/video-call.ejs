<%- include('partials/header') %>

<div class="container-fluid py-3">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <!-- Page header -->
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
          <a href="/dm/<%= other.username %>" class="text-decoration-none text-muted small">&larr; Back to chat</a>
          <span class="text-muted">|</span>
          <% if (other.avatar) { %>
            <img src="<%= other.avatar %>" class="rounded-circle" width="28" height="28" style="object-fit:cover">
          <% } else { %>
            <div class="avatar-xs"><%= other.username[0].toUpperCase() %></div>
          <% } %>
          <span class="fw-semibold small">Video call with @<%= other.username %></span>
        </div>
        <span id="callStatusBadge" class="badge bg-secondary">Ready</span>
      </div>

      <!-- Main video area -->
      <div class="card border mb-3">
        <div class="card-body p-0 position-relative bg-dark rounded" style="min-height:420px;">

          <!-- Remote video (full size) -->
          <video id="remoteVideo" autoplay playsinline
            class="w-100 rounded"
            style="min-height:420px; max-height:520px; object-fit:cover; background:#111; display:none;">
          </video>

          <!-- Waiting / idle screen -->
          <div id="idleScreen" class="d-flex flex-column align-items-center justify-content-center text-white"
            style="min-height:420px;">
            <% if (other.avatar) { %>
              <img src="<%= other.avatar %>" class="rounded-circle mb-3" width="80" height="80" style="object-fit:cover; border:3px solid #fff;">
            <% } else { %>
              <div class="avatar-xl mb-3"><%= other.username[0].toUpperCase() %></div>
            <% } %>
            <h5 class="mb-1">@<%= other.username %></h5>
            <p class="text-white-50 small mb-0" id="idleText">Press "Start Call" to call this user</p>
          </div>

          <!-- Incoming call overlay -->
          <div id="incomingCallOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none
            d-flex flex-column align-items-center justify-content-center"
            style="background:rgba(0,0,0,0.82); z-index:10; border-radius:8px;">
            <p class="text-white-50 small mb-2">Incoming call from</p>
            <h4 class="text-white mb-4" id="callerName"></h4>
            <div class="d-flex gap-3">
              <button class="btn btn-success btn-lg px-4" id="acceptBtn">Accept</button>
              <button class="btn btn-danger btn-lg px-4"  id="rejectBtn">Decline</button>
            </div>
          </div>

          <!-- My local video (picture-in-picture) -->
          <video id="localVideo" autoplay playsinline muted
            class="position-absolute rounded border border-white"
            style="width:140px; height:100px; object-fit:cover; bottom:14px; right:14px; background:#333; display:none;">
          </video>
        </div>
      </div>

      <!-- Controls -->
      <div class="card border">
        <div class="card-body py-2 px-3">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-primary" id="startCallBtn">
              Start Call
            </button>
            <button class="btn btn-danger d-none" id="endCallBtn">
              End Call
            </button>
            <button class="btn btn-outline-secondary" id="toggleMicBtn" disabled title="Mute/unmute">
              Mic On
            </button>
            <button class="btn btn-outline-secondary" id="toggleCamBtn" disabled title="Camera on/off">
              Camera On
            </button>
            <div class="ms-auto">
              <a href="/dm/<%= other.username %>" class="btn btn-outline-secondary btn-sm">
                Open Chat
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Call log -->
      <div class="mt-2" id="callLog" style="font-size:12px; color:#888;"></div>

    </div>
  </div>
</div>

<!-- Pass user data to JS -->
<script src="/socket.io/socket.io.js"></script>
<script>
  const ME    = { _id: "<%= me._id %>",    username: "<%= me.username %>",    avatar: "<%= me.avatar || '' %>" };
  const OTHER = { _id: "<%= other._id %>", username: "<%= other.username %>", avatar: "<%= other.avatar || '' %>" };
</script>
<script src="/js/video-call.js"></script>

<%- include('partials/footer') %>
