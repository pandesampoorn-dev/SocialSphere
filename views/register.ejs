<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - SocialSphere</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-5">
      <div class="text-center mb-4"><h2 class="fw-bold" style="color:#0d6efd;">SocialSphere</h2></div>
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h4 class="card-title mb-4">Create Account</h4>
          <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger"><ul class="mb-0 ps-3"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul></div>
          <% } %>
          <form action="/auth/register" method="POST">
            <div class="mb-3"><label class="form-label">Username</label><input type="text" name="username" class="form-control" value="<%= typeof old !== 'undefined' ? old.username : '' %>" required><div class="form-text">3-20 characters, letters/numbers/underscores</div></div>
            <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" value="<%= typeof old !== 'undefined' ? old.email : '' %>" required></div>
            <div class="mb-3"><label class="form-label">Password</label><input type="password" name="password" class="form-control" placeholder="Min 6 characters" required></div>
            <div class="mb-3"><label class="form-label">Confirm Password</label><input type="password" name="password2" class="form-control" required></div>
            <button type="submit" class="btn btn-primary w-100">Create Account</button>
          </form>
        </div>
      </div>
      <p class="text-center mt-3 text-muted">Already registered? <a href="/auth/login">Login</a></p>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
