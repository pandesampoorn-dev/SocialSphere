<%- include('partials/header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <a href="/" class="text-decoration-none text-muted small">&larr; Back to Feed</a>

      <div class="card border mt-3 mb-3">
        <div class="card-body p-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
              <% if (post.author.avatar) { %>
                <img src="<%= post.author.avatar %>" class="rounded-circle" width="36" height="36" style="object-fit:cover">
              <% } else { %>
                <div class="avatar-sm"><%= post.author.username[0].toUpperCase() %></div>
              <% } %>
              <div>
                <a href="/users/<%= post.author.username %>" class="fw-semibold text-decoration-none text-dark small">@<%= post.author.username %></a>
                <div class="text-muted" style="font-size:11px"><%= new Date(post.createdAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></div>
              </div>
            </div>
            <% if (isAuthor) { %>
              <div class="d-flex gap-2">
                <a href="/posts/<%= post._id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
                <form action="/posts/<%= post._id %>/delete" method="POST" onsubmit="return confirm('Delete this post?')">
                  <button class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
              </div>
            <% } %>
          </div>

          <h4 class="fw-bold mb-3"><%= post.title %></h4>

          <% if (post.body) { %>
            <div class="post-body mb-3"><%= post.body.replace(/\n/g, '<br>') %></div>
          <% } %>

          <!-- Media Gallery -->
          <% if (post.media && post.media.length > 0) { %>
            <div class="media-gallery mb-3">
              <% post.media.forEach(m => { %>
                <% if (m.type === 'video') { %>
                  <video src="<%= m.url %>" controls class="media-item" style="max-width:100%;border-radius:8px;margin-bottom:8px;"></video>
                <% } else { %>
                  <a href="<%= m.url %>" target="_blank">
                    <img src="<%= m.url %>" alt="Post image" class="media-item img-fluid rounded mb-2" style="max-height:500px;object-fit:cover;width:100%;">
                  </a>
                <% } %>
              <% }) %>
            </div>
          <% } %>

          <% if (post.tags && post.tags.length > 0) { %>
            <div class="mb-3">
              <% post.tags.forEach(tag => { %>
                <span class="badge bg-light text-secondary border me-1">#<%= tag %></span>
              <% }) %>
            </div>
          <% } %>

          <div class="d-flex align-items-center gap-3 pt-3 border-top">
            <form action="/posts/<%= post._id %>/like" method="POST">
              <button type="submit" class="btn btn-sm <%= liked ? 'btn-danger' : 'btn-outline-danger' %>">
                &#10084; <%= liked ? 'Liked' : 'Like' %> (<%= post.likes.length %>)
              </button>
            </form>
            <span class="text-muted small"><%= post.comments.length %> comment<%= post.comments.length !== 1 ? 's' : '' %></span>
            <a href="/dm/<%= post.author.username %>" class="btn btn-outline-secondary btn-sm ms-auto">Message @<%= post.author.username %></a>
          </div>
        </div>
      </div>

      <!-- Comments -->
      <div class="card border mb-3">
        <div class="card-header bg-white">
          <h6 class="mb-0 fw-semibold">Comments (<%= post.comments.length %>)</h6>
        </div>
        <div class="card-body p-0">
          <% if (post.comments.length === 0) { %>
            <p class="text-muted small text-center py-3 mb-0">No comments yet. Be the first!</p>
          <% } %>
          <% post.comments.forEach(c => { %>
            <div class="d-flex gap-2 px-3 py-2 border-bottom">
              <% if (c.author.avatar) { %>
                <img src="<%= c.author.avatar %>" class="rounded-circle flex-shrink-0" width="28" height="28" style="object-fit:cover">
              <% } else { %>
                <div class="avatar-xs flex-shrink-0"><%= c.author.username[0].toUpperCase() %></div>
              <% } %>
              <div>
                <div class="d-flex gap-2 align-items-baseline">
                  <a href="/users/<%= c.author.username %>" class="fw-semibold text-decoration-none text-dark" style="font-size:13px">@<%= c.author.username %></a>
                  <span class="text-muted" style="font-size:11px"><%= new Date(c.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
                </div>
                <p class="mb-0 small"><%= c.body %></p>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="card-footer bg-white">
          <form action="/posts/<%= post._id %>/comment" method="POST" class="d-flex gap-2">
            <input type="text" name="comment" class="form-control form-control-sm" placeholder="Write a comment..." maxlength="500" required>
            <button type="submit" class="btn btn-primary btn-sm">Post</button>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
