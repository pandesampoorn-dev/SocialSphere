<%- include('partials/header') %>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">

      <h5 class="fw-bold mb-3">Find People</h5>

      <form action="/users/search/results" method="GET" class="mb-4">
        <div class="input-group">
          <input type="search" name="q" class="form-control" value="<%= q %>"
                 placeholder="Search by username or bio..." autofocus>
          <button class="btn btn-primary" type="submit">Search</button>
        </div>
      </form>

      <% if (q) { %>
        <p class="text-muted small mb-3">
          <%= results.length %> result<%= results.length !== 1 ? 's' : '' %> for &quot;<%= q %>&quot;
        </p>
      <% } %>

      <% if (q && results.length === 0) { %>
        <div class="card border text-center py-5">
          <p class="text-muted mb-0">No users found for "<%= q %>"</p>
        </div>
      <% } %>

      <% results.forEach(u => { %>
        <div class="card border mb-3">
          <div class="card-body d-flex align-items-center gap-3">

            <!-- Avatar -->
            <a href="/users/<%= u.username %>" class="flex-shrink-0">
              <% if (u.avatar) { %>
                <img src="<%= u.avatar %>" class="rounded-circle"
                     width="48" height="48" style="object-fit:cover">
              <% } else { %>
                <div class="avatar-md d-flex align-items-center justify-content-center
                            rounded-circle bg-primary text-white fw-bold"
                     style="width:48px;height:48px;font-size:1.2rem;">
                  <%= u.username[0].toUpperCase() %>
                </div>
              <% } %>
            </a>

            <!-- Info -->
            <div class="flex-grow-1 min-width-0">
              <a href="/users/<%= u.username %>"
                 class="text-decoration-none text-dark fw-semibold">
                @<%= u.username %>
              </a>
              <% if (u.bio) { %>
                <p class="text-muted small mb-0 text-truncate"><%= u.bio %></p>
              <% } %>
              <span class="text-muted" style="font-size:12px;">
                <%= u.followers ? u.followers.length : 0 %> follower<%= (u.followers && u.followers.length === 1) ? '' : 's' %>
              </span>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 flex-shrink-0">
              <a href="/users/<%= u.username %>" class="btn btn-outline-secondary btn-sm">
                View Profile
              </a>
              <form action="/follow/<%= u._id %>" method="POST">
                <button type="submit"
                        class="btn btn-sm <%= u.isFollowing ? 'btn-outline-primary' : 'btn-primary' %>">
                  <%= u.isFollowing ? 'Unfollow' : 'Follow' %>
                </button>
              </form>
            </div>

          </div>
        </div>
      <% }) %>

    </div>
  </div>
</div>
<%- include('partials/footer') %>
